LET X = 10
LET Y = 45.67
LET G = TRUE
LET H = FALSE
LET K = "HELLO"

PRINT X
PRINT Y
PRINT G
PRINT H
PRINT K

// Float цикл
WHILE Y <= 254.56 THEN
    PRINT Y
    LET Y = Y + 45.67
WEND

// Int цикл с условием
LET I = 1
LET SUM = 0
WHILE I <= 10 THEN
    LET SUM = SUM + I
    LET I = I + 1
WEND
PRINT SUM

// Bool логика
LET A = TRUE
LET B = FALSE
LET C = TRUE
IF A AND C THEN
    PRINT "A AND C is true"
ELSE
    PRINT "A AND C is false"
END

IF A AND B THEN
    PRINT "A AND B is true"
ELSE
    PRINT "A AND B is false"
END

// FOR цикл
FOR N = 1 TO 5
    PRINT N
NEXT

// Вложенные условия
LET score = 85
IF score >= 90 THEN
    PRINT "A"
ELSE
    IF score >= 80 THEN
        PRINT "B"
    ELSE
        PRINT "C"
    END
END